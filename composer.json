{
    "name": "nelmio/api-doc-bundle",
    "description": "Generates documentation for your REST API from annotations and PHP 8 attributes",
    "keywords": ["api", "documentation", "doc", "rest"],
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Nelmio",
            "homepage": "http://nelm.io"
        },
        {
            "name": "Symfony Community",
            "homepage": "https://github.com/nelmio/NelmioApiDocBundle/contributors"
        }
    ],
    "require": {
        "php": ">=8.0",
        "symfony/twig-bundle": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/console": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/security-http": "^7.4",
        "doctrine/annotations": "^1.13|^2.0",
        "michelf/php-markdown": "^1.9|^2.0"
    },
    "conflict": {
        "jms/serializer": "<1.0",
        "jms/serializer-bundle": "<2.0",
        "twig/twig": "<3.0"
    },
    "require-dev": {
        "symfony/css-selector": "^7.4",
        "symfony/browser-kit": "^7.4",
        "symfony/validator": "^7.4",
        "symfony/yaml": "^7.4",
        "symfony/form": "^7.4",
        "symfony/finder": "^7.4",
        "symfony/serializer": "^7.4",
        "doctrine/orm": "^2.15|^3.0",
        "doctrine/doctrine-bundle": "^2.10",
        "friendsofsymfony/rest-bundle": "^3.0",
        "jms/serializer-bundle": "^4.0|^5.0",
        "symfony/phpunit-bridge": "^7.4",
        "phpunit/phpunit": "^9.0|^10.0"
    },
    "suggest": {
        "symfony/form": "For using form definitions as input.",
        "symfony/validator": "For making use of validator information in the doc.",
        "friendsofsymfony/rest-bundle": "For making use of REST information in the doc.",
        "api-platform/core": "For making use of API Platform resources (successor to DunglasApiBundle).",
        "jms/serializer": "For making use of serializer information in the doc.",
        "nelmio/cors-bundle": "For handling CORS in API documentation."
    },
    "autoload": {
        "psr-4": {
            "Nelmio\\ApiDocBundle\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-2.20.x": "2.20.x-dev"
        }
    }
}
